        Code {
            title: Some(
                "Examples",
            ),
            kind: Plain,
            children: [
                NewLine,
                Text(
                    "## view summaries",
                ),
                NewLine,
                Text(
                    "summary(penguins)",
                ),
                NewLine,
                Text(
                    "summary(penguins_raw)  # categorical variables are (still) character vectors",
                ),
                NewLine,
                Text(
                    "## summarize character vectors as factors:",
                ),
                NewLine,
                Text(
                    "summary(penguins_raw, character.method = \"factor\")",
                ),
                NewLine,
                NewLine,
                Text(
                    "## visualise distribution across factors",
                ),
                NewLine,
                Text(
                    "plot(island ~ species, data = penguins)",
                ),
                NewLine,
                Text(
                    "plot(sex ~ interaction(island, species, sep = \"",
                ),
                Command {
                    name: "n",
                    options: None,
                    args: [],
                },
                Text(
                    "\"), data = penguins)",
                ),
                NewLine,
                NewLine,
                Text(
                    "## bill depth vs. length by species (color) and sex (symbol):",
                ),
                NewLine,
                Text(
                    "## positive correlations for all species, males tend to have bigger bills",
                ),
                NewLine,
                Text(
                    "sym <- c(1, 16)",
                ),
                NewLine,
                Text(
                    "pal <- c(\"darkorange\",\"purple\",\"cyan4\")",
                ),
                NewLine,
                Text(
                    "plot(bill_dep ~ bill_len, data = penguins, pch = sym",
                ),
                Text(
                    "[",
                ),
                Text(
                    "sex",
                ),
                Text(
                    "]",
                ),
                Text(
                    ", col = pal",
                ),
                Text(
                    "[",
                ),
                Text(
                    "species",
                ),
                Text(
                    "]",
                ),
                Text(
                    ")",
                ),
                NewLine,
                NewLine,
                Text(
                    "## simplified sex dimorphism analysis for Adelie species:",
                ),
                NewLine,
                Text(
                    "## proportion of males increases with several size measurements",
                ),
                NewLine,
                Text(
                    "adelie <- subset(penguins, species == \"Adelie\")",
                ),
                NewLine,
                Text(
                    "plot(sex ~ bill_len, data = adelie)",
                ),
                NewLine,
                Text(
                    "plot(sex ~ bill_dep, data = adelie)",
                ),
                NewLine,
                Text(
                    "plot(sex ~ body_mass, data = adelie)",
                ),
                NewLine,
                Text(
                    "m <- glm(sex ~ bill_len + bill_dep + body_mass, data = adelie, family = binomial)",
                ),
                NewLine,
                Text(
                    "summary(m)",
                ),
                NewLine,
                NewLine,
                Text(
                    "## Produce the long variable names as from ",
                ),
                Text(
                    "{",
                ),
                Text(
                    "palmerpenguins",
                ),
                Text(
                    "}",
                ),
                Text(
                    " pkg:",
                ),
                NewLine,
                Text(
                    "long_nms <- sub(\"len\", \"length_mm\",",
                ),
                NewLine,
                Text(
                    "                sub(\"dep\",\"depth_mm\",",
                ),
                NewLine,
                Text(
                    "                    sub(\"mass\", \"mass_g\", colnames(penguins))))",
                ),
                NewLine,
                Text(
                    "## compare long and short names:",
                ),
                NewLine,
                Text(
                    "noquote(rbind(long_nms, nms = colnames(penguins)))",
                ),
                NewLine,
                NewLine,
                Code {
                    title: None,
                    kind: DontRun,
                    children: [
                        Text(
                            " # << keeping shorter 'penguins' names in this example:",
                        ),
                        NewLine,
                        Text(
                            "    colnames(penguins) <- long_nms",
                        ),
                        NewLine,
                    ],
                },
                NewLine,
            ],
